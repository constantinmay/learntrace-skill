{
  "name": "learntrace-agent-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "rolldown src/service.ts --file ../src/learntrace/ui/agent-service.mjs --format esm --platform node --no-codeSplitting --no-treeshake --strictExecutionOrder",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "rolldown": "1.2.7",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
