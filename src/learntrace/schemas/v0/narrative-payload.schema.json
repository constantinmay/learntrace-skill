{
  "$id": "narrative-payload.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NarrativePayload",
  "description": "叙事层 payload(宿主 agent → CLI 渲染的中间产物,v0 纯新增)。agent 只负责填写叙述文本与引用；章节骨架、表格、元信息表与脚注定义由 CLI 渲染器生成。引用必须可解析到档案中的可观察事件；引用对象可携带证据位置字段（文件+行号 / 提交哈希 / 会话导出+消息区间），支撑证据重读。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer",
    "variant",
    "meta",
    "overview",
    "stages",
    "turning_points",
    "ai_collaboration",
    "verification",
    "reflection",
    "takeaways",
    "evidence_gaps"
  ],
  "properties": {
    "schema_note": {
      "type": "string",
      "description": "可选的草案说明（golden 样例保留此字段；正式 payload 可省略）。"
    },
    "layer": {
      "const": "narrative_payload",
      "description": "固定层标识：本记录属于叙事层，不修改确定性层的三层证据语义。"
    },
    "variant": {
      "enum": ["working", "submitted"],
      "description": "渲染目标版本：working=未确认版；submitted=上交版。"
    },
    "author_scope": {
      "enum": ["self_only"],
      "description": "作者范围声明。多作者仓库默认 self_only：仅报告本人名下工作，协作内容以范围边界标注呈现，不做逐提交归属与贡献度排名。"
    },
    "intro_note": {
      "type": "string",
      "minLength": 1,
      "description": "可选的开篇说明（上交版第一人称叙述）。工作版渲染固定模板，不使用此字段。"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "evidence_window", "status", "pending_questions", "evidence_gaps"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "evidence_window": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "pending_questions": { "type": "integer", "minimum": 0 },
        "evidence_gaps": { "type": "integer", "minimum": 0 }
      },
      "description": "报告元信息，用于渲染表头。pending_questions/evidence_gaps 的数量必须与 learning-questions / evidence_gaps 一致（verify 红线 3 的一部分）。"
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "citations"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "citations": { "$ref": "#/$defs/citations" }
      },
      "description": "项目概述（事实层）。"
    },
    "diagram": {
      "type": "string",
      "minLength": 1,
      "description": "可选的 mermaid 图源（关键转折章节）。由宿主 agent 撰写，CLI 只渲染不解释。"
    },
    "stages": { "$ref": "#/$defs/stages" },
    "turning_points": { "$ref": "#/$defs/turning_points" },
    "ai_collaboration": { "$ref": "#/$defs/ai_collaboration" },
    "ai_statement": {
      "type": "string",
      "minLength": 1,
      "description": "上交版「AI 使用声明」全文(第一人称,由学生本人复核);工作版不渲染此字段。"
    },
    "verification": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "验证与质量小节条目（事实层，variant 无关 → 上交版与工作版逐字一致）。"
    },
    "reflection": { "$ref": "#/$defs/reflection" },
    "takeaways": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "学习收获条目。未确认版允许为空（渲染为「未记录」占位）；上交版须由学生本人填写。"
    },
    "evidence_gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "证据边界条目；数量必须等于 meta.evidence_gaps。"
    }
  },
  "$defs": {
    "event_id": {
      "$ref": "common.schema.json#/$defs/record_id"
    },
    "citation": {
      "anyOf": [
        { "$ref": "#/$defs/event_id" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_id"],
          "properties": {
            "event_id": { "$ref": "#/$defs/event_id" },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "语义脚注标签（如 doc-intro / c-06f5aed / t-debug）。正文脚注引用该标签；内部事件 ID 只出现在脚注定义中。"
            },
            "evidence_location": { "$ref": "#/$defs/evidence_location" }
          },
          "description": "带标签与可选证据位置的引用对象。"
        }
      ],
      "description": "对档案内可观察事件的引用：裸事件 ID（脚注标签由渲染器派生），或携带语义标签/证据位置的对象。"
    },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" },
      "description": "一组引用；每个引用必须解析到档案中的可观察事件（verify 红线 1）。"
    },
    "key_change": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": {
              "enum": ["Added", "Removed", "Fixed", "Changed", "Note", "Collaboration"]
            },
            "text": { "type": "string", "minLength": 1 },
            "citations": { "$ref": "#/$defs/citations" }
          },
          "description": "带 kind 的阶段条目：阶段详情按 kind 分组渲染为 **Added**/**Removed**/**Fixed**/**Changed**/协作边界 小节；开发轨迹表只取 text。"
        }
      ],
      "description": "阶段关键结果：纯文本（开发轨迹表用），或带 kind 的对象（阶段详情分组用）。"
    },
    "evidence_location": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "source_file" },
            "path": { "type": "string", "minLength": 1 },
            "line_range": { "type": "string", "minLength": 1 }
          },
          "description": "方式一直接定位：源文件路径 + 行号区间。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "hash"],
          "properties": {
            "kind": { "const": "git_commit" },
            "hash": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" }
          },
          "description": "方式一直接定位：Git 提交哈希。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "export_path", "session_id"],
          "properties": {
            "kind": { "const": "session_export" },
            "export_path": { "type": "string", "minLength": 1 },
            "session_id": { "type": "string", "minLength": 1 },
            "message_id_range": { "type": "string", "minLength": 1 }
          },
          "description": "方式一直接定位：会话导出文件 + 会话 ID + 消息 ID 区间。"
        }
      ],
      "description": "证据位置字段：引用可被人工/agent 直接重读的落点（方式一）。方式二（按需导出到 .learntrace/evidence/）不在本 schema 内。"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "title", "goal", "key_changes", "citations"],
      "properties": {
        "stage_id": { "type": "string", "pattern": "^stage-[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["observed", "inferred_truncated"],
          "description": "inferred_truncated=档案截断产生的推断 stage-0：过程未完整记录，仅从合并消息推断范围。"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "description": "阶段目标（agent 叙述）。inferred_truncated 阶段不渲染目标行。"
        },
        "key_changes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/key_change" },
          "description": "开发轨迹表「关键结果」列内容与阶段详情条目（fact 层，variant 无关）。"
        },
        "citations": { "$ref": "#/$defs/citations" },
        "evidence_gaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "该阶段的证据缺口（阶段详情内呈现）。"
        },
        "merge_anchor": {
          "anyOf": [
            { "$ref": "#/$defs/event_id" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/event_id" },
              "minItems": 1,
              "uniqueItems": true
            }
          ],
          "description": "主线合入点锚（merge commit 事件 ID）。锚只作阶段边界提示，不作阶段内容。"
        }
      }
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage" },
      "minItems": 1
    },
    "turning_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "status", "body", "citations"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["confirmed", "supplemented", "denied_kept_in_appendix"],
          "description": "denied_kept_in_appendix=学生否认的推断，只允许出现在附录；其 basis 事件不得被 confirmed/supplemented 转折引用（verify 红线 2）。"
        },
        "body": { "type": "string", "minLength": 1 },
        "citations": { "$ref": "#/$defs/citations" }
      }
    },
    "turning_points": {
      "type": "array",
      "items": { "$ref": "#/$defs/turning_point" }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "body", "citations", "derived"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "citations": { "$ref": "#/$defs/citations" },
        "derived": {
          "type": "boolean",
          "description": "true=派生摘要（经完整对话授权后由宿主 agent 蒸馏），必须携带 derivation 与 deniable。"
        },
        "derivation": {
          "const": "host_agent_episode_digest",
          "description": "派生方式标记。"
        },
        "deniable": {
          "const": true,
          "description": "派生摘要可被学生否认。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "derived": { "const": true } },
            "required": ["derived"]
          },
          "then": { "required": ["derivation", "deniable"] }
        }
      ]
    },
    "ai_collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "shape", "focus", "episodes", "boundary"],
      "properties": {
        "coverage": {
          "type": "string",
          "minLength": 1,
          "description": "可见性地图：授权轨迹覆盖窗口，以及「仅代表已授权会话」声明。"
        },
        "shape": {
          "type": "string",
          "minLength": 1,
          "description": "活动形状。"
        },
        "focus": {
          "type": "string",
          "minLength": 1,
          "description": "文件焦点。"
        },
        "episodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/episode" },
          "minItems": 1,
          "description": "关键插曲，必须至少一条（AI 章节不能只是缺失声明）。"
        },
        "boundary": {
          "type": "string",
          "minLength": 1,
          "description": "边界声明：轨迹与提交不建立对应关系。"
        }
      },
      "description": "AI 协作五要素（可见性地图/活动形状/文件焦点/关键插曲/边界声明）。"
    },
    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "const": "student_authored_only",
          "description": "反思层恒为学生本人：系统不代写。"
        },
        "text": {
          "type": ["string", "null"],
          "description": "学生本人填写的反思；未确认版必须为 null（占位渲染，verify 红线 3 检查 agent 不代写）。"
        }
      }
    }
  }
}
